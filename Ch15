#include <iostream>
using namespace std;
//Function Overloading Example
class Calculator
{
public:
    int add(int first_number, int second_number)
    {
        return first_number + second_number;
    }
    double add(double first_number, double second_number)
    {
        return first_number + second_number;
    }
};

//Practice 101: Smart Restaurant Bill Calculator
class BillCalculator
{
public: 
    int calculateBill(int burger_price, int pizza_price)
    {
        return burger_price + pizza_price;
    }
    double calculateBill(double food_total, double tax_rate)
    {
        return food_total + (food_total * tax_rate);
    }
    double calculateBill(double food_total, double tax_rate, double discount)
    {
        return (food_total + (food_total * tax_rate)) - discount;
    }
};

//Practice 102: Student Result Analyzer
class ResultAnalyzer
{
public:
    int calculateResult(int mark1, int mark2)
    {
        return mark1 + mark2;
    }
    int calculateResult(int mark1, int mark2, int mark3)
    {
        return mark1 + mark2 + mark3;
    }
    double calculateResult(double total_marks, int subjects)
    {
        return total_marks / subjects;
    }
};

//Operator Overloading Example
class Box
{
public:
    int value;
    Box operator+(Box second_box)
    {
        Box result_box;
        result_box.value = value + second_box.value;
        return result_box;
    }
};

//Practice 103:Box Storage Divider
class StorageBox
{
private:
    int item_count;
public:
    void set_item_count(int count)
    {
        item_count = count;
    }
    int get_item_count()
    {
        return item_count;
    }
    StorageBox operator/(int divisor)
    {
        StorageBox result_box;
        if (divisor != 0)
        {
            result_box.item_count = item_count / divisor;
        }
        else
        {
            cout << "Error, you divised by 0." << endl;
            result_box.item_count = 0;
        }
        return result_box;
    }
};

//Practice 104: Bank Balance Comparison
class BankAccount
{
private:
    int balance;
public:
    void set_balance(double amount)
    {
        balance = amount;
    }
    bool operator==(BankAccount second_account)
    {
        if (balance == second_account.balance)
        {
            return true;
        }
        else
        {
            return false;
        }
    }
};

