{
public:
    int books_borrowed;
};
int main()
{
    //Practice 87: Employee Bonus
    Manager manager1;
    double total_income;
    cout << "Enter the manager's name: ";
    getline(cin, manager1.employee_name);
    cout << "Enter salary: ";
    cin >> manager1.salary;
    cout << "Enter bonus: ";
    cin >> manager1.bonus;
    total_income = manager1.salary + manager1.bonus;
    cout << "Manager Name: " << manager1.employee_name << endl;
    cout << "Salary: " << manager1.salary << endl;
    cout << "Bonus: " << manager1.bonus << endl;
    cout << "Total Income: " << total_income << endl;
    
    //Practice 88: Online Order Bill
    DiscountedProduct product1;
    double discount_amount;
    double final_price;
    cout << "Enter the product name: ";
    getline(cin, product1.product_name);
    cout << "Enter the price: ";
    cin >> product1.product_price;
    cout << "Enter the discount: ";
    cin >> product1.discount_percentage;
    discount_amount = product1.product_price * product1.discount_percentage / 100;
    final_price = product1.product_price - discount_amount;
    cout << "Product Name: " << product1.product_name << endl;
    cout << "Original Price: " << product1.product_price << endl;
    cout << "Discount Percentage: " << discount_amount << endl;
    cout << "Final Price: " << final_price << endl;

    //Practice 89: School to College Student
    GraduateStudent person1;
