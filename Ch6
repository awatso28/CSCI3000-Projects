//Three Ways Structures Work With Functions Example
void change_marks(student_record &student_ref)
{
    student_ref.marks = 50;

    cout << "Inside function (reference): " << student_ref.marks << endl;

    cout << "Address inside function: " << &student_ref << endl;
}
student_record create_student()
{
    student_record temp_student;
    temp_student.roll_number = 10;
    temp_student.marks = 85;
    return temp_student;
}
//Practice 52: Create Product and Return It
product_record create_product(int product_id, float price)
{
    product_record temp_product;
    temp_product.product_id = product_id;
    temp_product.price = price;
    return temp_product;
}
//Practice 53: Return Total and Average as a Structure
result_record calculate_result(int mark1, int mark2, int mark3)
{
    result_record temp_result;
    temp_result.total = mark1 + mark2 + mark3;
    temp_result.average = temp_result.total / 3.0f;
    return temp_result;
}
