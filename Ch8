    cin >> user_choice;
    TrafficLight signal1 = (TrafficLight)user_choice;
    switch (signal1)
    {
    case Red:
        cout << "STOP" << endl;
        break;
    case Yellow:
        cout << "GET READY" << endl;
        break;
    case Green:
        cout << "GO" << endl;
        break;
    default:
        cout << "Invalid Input!";
    }
