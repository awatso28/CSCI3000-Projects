#include <iostream>
#include <string>
using namespace std;
//What is an Enumeration? Example
enum Day
{
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday
};
//Enum with Constant Values
enum error
{
    success = 200,
    not_found = 404,
    server_error = 500
};
//Using enum in switch
enum TrafficLight
{
    Red,
    Yellow,
    Green
};
//Practice 54: Smart Device Power State
enum PowerState
{
    Off,
    On,
    Sleep
};
//Practice 54: Restaurant Order Status Tracker
enum OrderStatus
{
    Placed, 
    Cooking,
    Ready,
    Delivered
};
//Practice 55: ATM TRansaction Menu
enum TransactionType
{
    Deposit,
    Withdraw,
    CheckBalance,
    Exit
};
//Practice 56: Smart Home Mode Controller
enum HomeMode
{
    Home = 1,
    Away = 2,
    Night = 3,
    Vacation = 4
};
int main()
{
    //What is an Enumeration? Example
    Day today = Wednesday;
    cout << today << endl;
    //Memory Concept Example
    cout << sizeof(Day) << endl;
    //Enum with Constant Values
    error current_error = not_found;
    cout << "Error Code: " << current_error << endl;
    //Using enum in switch
    TrafficLight signal = Green;
    switch (signal)
    {
    case Red:
        cout << "STOP" << endl;
        break;
    case Yellow:
        cout << "GET READY" << endl;
        break;
    case Green:
        cout << "GO" << endl;
        break;
    }
