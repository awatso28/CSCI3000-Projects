    else
    {
        cout << "Invalid Input!";
        return 0;
    }
    switch (signal2)
    {
    case Red:
        cout << "STOP" << endl;
        break;
    case Yellow:
        cout << "GET READY" << endl;
        break;
    case Green:
        cout << "GO" << endl;
        break;
    }
