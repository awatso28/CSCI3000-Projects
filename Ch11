#include <iostream>
#include <string>
using namespace std;
//Full Example Program (Slide 12)
class BankAccount
{
private:
    float balance;
public:
    void setBalance(float bal);
    float getBalance();
};
void BankAccount::setBalance(float bal)
{
    if (bal >= 0)
    {
        balance = bal;
    }
}
float BankAccount::getBalance()
{
    return balance;
}

//Practice 75: Book Record System
class Book
{
private:
    string book_title;
    float book_price;
public:
    void setBook(string title, float price);
    void displayBook();
};
void Book::setBook(string title, float price)
{
    book_title = title;
    book_price = price;
}
void Book::displayBook()
{
    cout << "Book Title: " << book_title << endl;
    cout << "Book Price: " << book_price << endl;
}

